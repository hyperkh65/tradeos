{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YNK Groupware",
  "version": "0.1.0",
  "identifier": "com.ynk2014.groupware",
  "build": {
    "frontendDist": "../tauri-dist"
  },
  "app": {
    "windows": [
      {
        "title": "YNK 그룹웨어",
        "url": "https://gw.ynk2014.com",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
