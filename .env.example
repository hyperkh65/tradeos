NEXT_PUBLIC_APP_NAME=TradeOS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notion Integration
NOTION_TOKEN=
NOTION_DB_EMPLOYEES=
NOTION_DB_DEPARTMENTS=
NOTION_DB_COMPANIES=
NOTION_DB_CONTACTS=
NOTION_DB_PRODUCTS=
NOTION_DB_PROJECTS=
NOTION_DB_TASKS=
NOTION_DB_QUOTES=
NOTION_DB_PURCHASE_ORDERS=
NOTION_DB_PRODUCTION=
NOTION_DB_INSPECTIONS=
NOTION_DB_SHIPMENTS=
NOTION_DB_IMPORTS=
NOTION_DB_EXPENSES=
NOTION_DB_PAYMENTS=
NOTION_DB_CLAIMS=
NOTION_DB_CERTIFICATES=
NOTION_DB_CONTRACTS=
NOTION_DB_DOCUMENTS=
NOTION_DB_APPROVALS=
NOTION_DB_ACTIVITY_LOGS=
NOTION_DB_INVENTORY=

# NAS Storage (WebDAV)
NAS_WEBDAV_URL=
NAS_USERNAME=
NAS_PASSWORD=
NAS_BASE_PATH=/TradeOS
NAS_PUBLIC_BASE_URL=

# Cloud Backup
CLOUD_BACKUP_PROVIDER=webdav
CLOUD_WEBDAV_URL=
CLOUD_USERNAME=
CLOUD_PASSWORD=
CLOUD_BASE_PATH=/TradeOS-Backup

# Mail (IMAP/SMTP)
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Authentication
AUTH_SECRET=change-me-in-production-min-32-chars

# Demo mode (set true to use sample data without real integrations)
DEMO_MODE=false

# AI 도우미 (사내 AI Assistant)
# - Cloudflare Provider(계정/토큰), Qdrant 연결정보는 실제 운영값을 여기 넣지 않고
#   /settings/ai 관리자 화면에서 등록한다(암호화되어 DB에 저장됨). 아래 환경변수는
#   admin이 아직 설정하지 않았을 때의 fallback이거나, 비상 강제 종료용이다.
# AI_ENABLED=false로 설정하면 admin 설정과 무관하게 AI 기능이 전체 비활성화된다(비상 킬스위치).
AI_ENABLED=
# admin UI에서 설정하지 않았을 때 사용할 Qdrant 기본 접속정보(내부망 전용, 외부 노출 금지)
QDRANT_URL=
QDRANT_API_KEY=
